{
  "version": "0.2.0",
  "list_policy": {
    "ttlMs": 30000,
    "cacheScope": "private",
    "varies_by": "authorization_on_current_request",
    "must_not_vary_by": ["connection", "session_history", "prior_tool_calls"],
    "deterministic_order": true
  },
  "stable_order": [
    "atos_search",
    "atos_get_capability",
    "atos_quote",
    "atos_invoke",
    "atos_create_job",
    "atos_get_job",
    "atos_cancel_job",
    "atos_account",
    "atos_artifact",
    "atos_register_capability",
    "atos_update_capability",
    "atos_list_my_capabilities",
    "atos_pause_capability",
    "atos_provider_jobs",
    "atos_deliver_job",
    "atos_request_settlement",
    "atos_dispute_job"
  ],
  "tools": [
    {
      "name": "atos_search",
      "description": "Search and rank ATOS capabilities by natural-language intent, trust policy, proof requirements, and constraints.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["query"],
        "additionalProperties": false,
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "filters": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "requested_trust_mode": {"type": "string", "enum": ["managed", "verified", "native", "auto"], "default": "auto"},
              "proof_requirements": {"type": "object"},
              "max_price": {"type": "object"},
              "delivery_modes": {"type": "array", "items": {"type": "string", "enum": ["instant", "async", "interactive"]}, "uniqueItems": true},
              "min_trust_score": {"type": "number", "minimum": 0, "maximum": 1},
              "max_latency_ms": {"type": "integer", "minimum": 0}
            }
          },
          "limit": {"type": "integer", "minimum": 1, "maximum": 20, "default": 5},
          "cursor": {"type": ["string", "null"]}
        }
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["matches"],
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["capability_id", "name", "supported_trust_modes", "requires_artifact_transfer"],
              "properties": {
                "capability_id": {"type": "string"},
                "name": {"type": "string"},
                "summary": {"type": "string"},
                "supported_trust_modes": {"type": "array", "items": {"type": "string", "enum": ["managed", "verified", "native"]}},
                "requires_artifact_transfer": {"type": "boolean"},
                "artifact_input_fields": {"type": "array", "items": {"type": "string"}},
                "artifact_output_fields": {"type": "array", "items": {"type": "string"}},
                "pricing_hint": {"type": "object"},
                "trust_summary": {"type": "object"},
                "match_score": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          },
          "next_cursor": {"type": ["string", "null"]}
        }
      }
    },
    {
      "name": "atos_get_capability",
      "description": "Get capability metadata, schemas, active trust modes, proof profiles, bindings, and artifact-transfer requirements.",
      "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["capability_id"], "additionalProperties": false, "properties": {"capability_id": {"type": "string", "minLength": 1}}},
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["id", "provider_id", "name", "version", "delivery_mode", "supported_trust_modes", "input_schema", "output_schema", "requires_artifact_transfer"],
        "properties": {
          "id": {"type": "string"}, "provider_id": {"type": "string"}, "name": {"type": "string"}, "version": {"type": "string"},
          "delivery_mode": {"type": "string", "enum": ["instant", "async", "interactive"]},
          "supported_trust_modes": {"type": "array", "items": {"type": "string", "enum": ["managed", "verified", "native"]}},
          "mode_support": {"type": "object"}, "trust_summary": {"type": "object"}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"},
          "pricing": {"type": "object"}, "bindings": {"type": "array"}, "requires_artifact_transfer": {"type": "boolean"},
          "artifact_input_fields": {"type": "array", "items": {"type": "string"}}, "artifact_output_fields": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    {
      "name": "atos_quote",
      "description": "Create a time-limited executable quote and resolve requested trust policy to one concrete trust mode.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["capability_id"], "additionalProperties": false,
        "properties": {
          "capability_id": {"type": "string", "minLength": 1}, "input_summary": {"type": "object"},
          "requested_trust_mode": {"type": "string", "enum": ["managed", "verified", "native", "auto"], "default": "auto"},
          "proof_requirements": {"type": "object"}, "constraints": {"type": "object"}
        }
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object",
        "required": ["quote_id", "capability_id", "capability_version", "provider_id", "requested_trust_mode", "trust_mode", "price", "settlement", "proof", "expires_at", "terms_hash"],
        "properties": {
          "quote_id": {"type": "string"}, "capability_id": {"type": "string"}, "capability_version": {"type": "string"}, "provider_id": {"type": "string"},
          "requested_trust_mode": {"type": "string", "enum": ["managed", "verified", "native", "auto"]},
          "trust_mode": {"type": "string", "enum": ["managed", "verified", "native"]}, "proof_profile": {"type": ["string", "null"]},
          "price": {"type": "object"}, "settlement": {"type": "object"}, "proof": {"type": "object"}, "expires_at": {"type": "string"},
          "requires_confirmation": {"type": "boolean"}, "terms_hash": {"type": "string"}, "dispute_policy_hash": {"type": ["string", "null"]}
        }
      }
    },
    {
      "name": "atos_invoke",
      "description": "Invoke a bounded capability using an executable quote. Trust mode is inherited from the quote.",
      "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["capability_id", "quote_id", "input", "idempotency_key"], "additionalProperties": false, "properties": {"capability_id": {"type": "string"}, "quote_id": {"type": "string"}, "input": {}, "idempotency_key": {"type": "string", "minLength": 1}, "max_wait_ms": {"type": "integer", "minimum": 1000, "maximum": 120000}}},
      "outputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["result_type", "quote_id", "trust_mode"], "properties": {"result_type": {"type": "string", "enum": ["completed", "accepted", "input_required", "failed"]}, "invocation_id": {"type": ["string", "null"]}, "job_id": {"type": ["string", "null"]}, "quote_id": {"type": "string"}, "trust_mode": {"type": "string", "enum": ["managed", "verified", "native"]}, "output": {}, "artifacts": {"type": "array"}, "receipt": {"type": ["object", "null"]}}}
    },
    {
      "name": "atos_create_job",
      "description": "Create long-running or interactive work. Trust mode is inherited from the quote.",
      "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["capability_id", "quote_id", "input", "idempotency_key"], "additionalProperties": false, "properties": {"capability_id": {"type": "string"}, "quote_id": {"type": "string"}, "input": {}, "idempotency_key": {"type": "string", "minLength": 1}, "callback": {"type": "null"}}},
      "outputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["job_id", "quote_id", "trust_mode", "state", "created_at"], "properties": {"job_id": {"type": "string"}, "quote_id": {"type": "string"}, "trust_mode": {"type": "string", "enum": ["managed", "verified", "native"]}, "proof_profile": {"type": ["string", "null"]}, "state": {"type": "string", "enum": ["submitted", "working", "input_required", "completed", "failed", "canceled", "rejected"]}, "created_at": {"type": "string"}, "estimated_completion_at": {"type": ["string", "null"]}}}
    },
    {
      "name": "atos_get_job",
      "description": "Get current state, concrete trust mode, proof progress, messages, and artifacts of an ATOS job.",
      "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["job_id"], "additionalProperties": false, "properties": {"job_id": {"type": "string"}}},
      "outputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["job_id", "trust_mode", "state"], "properties": {"job_id": {"type": "string"}, "quote_id": {"type": "string"}, "trust_mode": {"type": "string", "enum": ["managed", "verified", "native"]}, "proof_profile": {"type": ["string", "null"]}, "state": {"type": "string"}, "proof_status": {"type": "object"}, "messages": {"type": "array"}, "artifacts": {"type": "array"}, "receipt": {"type": ["object", "null"]}}}
    },
    {
      "name": "atos_cancel_job",
      "description": "Request cancellation of a non-terminal job while preserving quoted trust/settlement guarantees.",
      "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["job_id", "idempotency_key"], "additionalProperties": false, "properties": {"job_id": {"type": "string"}, "reason": {"type": "string"}, "idempotency_key": {"type": "string", "minLength": 1}}},
      "outputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["job_id", "trust_mode", "state"], "properties": {"job_id": {"type": "string"}, "trust_mode": {"type": "string", "enum": ["managed", "verified", "native"]}, "state": {"type": "string"}, "settlement_status": {"type": ["string", "null"]}}}
    },
    {
      "name": "atos_account",
      "description": "Get account balance, usage, autonomous spending policy, and default trust policy.",
      "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false},
      "outputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "properties": {"balance": {"type": "object"}, "spend_policy": {"type": "object"}, "trust_policy": {"type": "object"}, "provider_earnings": {"type": ["object", "null"]}}}
    },
    {
      "name": "atos_artifact",
      "description": "Work with ATOS artifacts using signed URLs. Binary bytes never travel through this MCP call.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["operation", "content_type", "size_bytes", "purpose"], "properties": {"operation": {"const": "create_upload"}, "content_type": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "purpose": {"type": "string", "enum": ["job_input", "capability_asset"]}}},
          {"type": "object", "additionalProperties": false, "required": ["operation", "upload_id"], "properties": {"operation": {"const": "complete_upload"}, "upload_id": {"type": "string", "minLength": 1}}},
          {"type": "object", "additionalProperties": false, "required": ["operation", "artifact_id"], "properties": {"operation": {"const": "get_download_url"}, "artifact_id": {"type": "string", "minLength": 1}}}
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["operation", "upload_id", "upload_url", "upload_method", "expires_at"], "properties": {"operation": {"const": "create_upload"}, "upload_id": {"type": "string"}, "upload_url": {"type": "string"}, "upload_method": {"const": "PUT"}, "expires_at": {"type": "string"}}},
          {"type": "object", "additionalProperties": false, "required": ["operation", "artifact_id", "content_type", "size_bytes", "sha256"], "properties": {"operation": {"const": "complete_upload"}, "artifact_id": {"type": "string"}, "content_type": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string"}}},
          {"type": "object", "additionalProperties": false, "required": ["operation", "download_url", "expires_at", "content_type", "size_bytes"], "properties": {"operation": {"const": "get_download_url"}, "download_url": {"type": "string"}, "expires_at": {"type": "string"}, "content_type": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 0}}}
        ]
      }
    }
  ],
  "conditionally_visible_tools": {
    "_comment": "These definitions are not in the ordinary consumer surface. Current-request scopes are mandatory; role/ownership may further narrow visibility. Every tools/call re-checks authorization.",
    "capability_management": [
      {
        "name": "atos_register_capability",
        "description": "Register a provider capability and request concrete trust modes. Requires capabilities:write.",
        "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["name", "description", "delivery_mode", "input_schema", "output_schema", "pricing", "requested_trust_modes"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "delivery_mode": {"type": "string", "enum": ["instant", "async", "interactive"]}, "input_schema": {"type": "object"}, "output_schema": {"type": "object"}, "pricing": {"type": "object"}, "tags": {"type": "array", "items": {"type": "string"}}, "requested_trust_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["managed", "verified", "native"]}}, "bindings": {"type": "array"}}},
        "outputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["capability_id", "requested_trust_modes", "supported_trust_modes", "mode_support"], "properties": {"capability_id": {"type": "string"}, "requested_trust_modes": {"type": "array"}, "supported_trust_modes": {"type": "array"}, "mode_support": {"type": "object"}}}
      },
      {
        "name": "atos_update_capability",
        "description": "Update mutable capability metadata or requested trust modes. Requires capabilities:write and target ownership.",
        "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["capability_id", "patch"], "additionalProperties": false, "properties": {"capability_id": {"type": "string"}, "patch": {"type": "object", "additionalProperties": true}}},
        "outputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["capability_id", "supported_trust_modes", "mode_support"], "properties": {"capability_id": {"type": "string"}, "supported_trust_modes": {"type": "array"}, "mode_support": {"type": "object"}, "updated_at": {"type": "string"}}}
      },
      {
        "name": "atos_list_my_capabilities",
        "description": "List capabilities owned by the authenticated provider. Requires capabilities:write.",
        "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false},
        "outputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["capabilities"], "properties": {"capabilities": {"type": "array"}}}
      },
      {
        "name": "atos_pause_capability",
        "description": "Pause one capability owned by the authenticated provider. Requires capabilities:write and target ownership.",
        "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["capability_id"], "additionalProperties": false, "properties": {"capability_id": {"type": "string"}}},
        "outputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["capability_id", "status"], "properties": {"capability_id": {"type": "string"}, "status": {"type": "string"}}}
      }
    ],
    "later_provider_operations": [
      {"name": "atos_provider_jobs", "required_scopes": ["provider_jobs:read"], "status": "specified_not_implemented"},
      {"name": "atos_deliver_job", "required_scopes": ["provider_jobs:deliver"], "status": "specified_not_implemented"},
      {"name": "atos_request_settlement", "required_scopes": [], "status": "scope_to_be_defined_before_implementation"},
      {"name": "atos_dispute_job", "required_scopes": [], "status": "scope_to_be_defined_before_implementation"}
    ]
  },
  "visibility_rules": [
    {"tool": "atos_search", "required_scopes": ["capabilities:read"]},
    {"tool": "atos_get_capability", "required_scopes": ["capabilities:read"]},
    {"tool": "atos_quote", "required_scopes": ["quotes:read"]},
    {"tool": "atos_invoke", "required_scopes": ["invocations:create"]},
    {"tool": "atos_create_job", "required_scopes": ["jobs:create"]},
    {"tool": "atos_get_job", "required_scopes": ["jobs:read"]},
    {"tool": "atos_cancel_job", "required_scopes": ["jobs:cancel"]},
    {"tool": "atos_account", "required_scopes": ["account:read"]},
    {"tool": "atos_artifact", "required_scopes": [], "operation_authorization": "see docs/AUTH.md and docs/ARTIFACTS.md"},
    {"tool": "atos_register_capability", "required_scopes": ["capabilities:write"]},
    {"tool": "atos_update_capability", "required_scopes": ["capabilities:write"], "resource_check": "target capability ownership"},
    {"tool": "atos_list_my_capabilities", "required_scopes": ["capabilities:write"]},
    {"tool": "atos_pause_capability", "required_scopes": ["capabilities:write"], "resource_check": "target capability ownership"}
  ],
  "invariants": [
    "a fully scoped ordinary consumer sees nine tools",
    "authorization-sensitive tools/list results use private cache scope",
    "tools/list ordering is deterministic for the same visible set",
    "tool visibility never substitutes for tools/call authorization",
    "atos_artifact uses operation-discriminated input and output schemas",
    "auto is accepted only as requested_trust_mode before quote resolution",
    "quote output trust_mode is always managed, verified, or native",
    "invoke and create_job do not accept a trust_mode override",
    "jobs and receipts inherit the quote trust_mode",
    "provider requested_trust_modes are not active supported_trust_modes",
    "verified/native failures never silently downgrade to managed"
  ]
}