{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atos.im/schemas/managed-financial-integrity-v1.json",
  "title": "ATOS Managed Financial Integrity V1",
  "$defs": {
    "digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "atomicAmount": {"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
    "identities": {
      "type":"object","additionalProperties":false,
      "required":["principal_id","provider_id","job_id","quote_id","capability_id","capability_version","billing_snapshot_id","execution_receipt_id","settlement_id","provider_earning_id","dispute_id","payout_id"],
      "properties": {
        "principal_id":{"type":"string"},"provider_id":{"type":"string"},
        "job_id":{"type":"string"},"quote_id":{"type":"string"},
        "capability_id":{"type":"string"},"capability_version":{"type":"string"},
        "billing_snapshot_id":{"type":"string"},"execution_receipt_id":{"type":"string"},
        "settlement_id":{"type":"string"},"provider_earning_id":{"type":"string"},
        "dispute_id":{"type":"string"},"payout_id":{"type":"string"}
      }
    },
    "posting": {
      "type":"object","additionalProperties":false,
      "required":["entry_index","account_code","account_owner_id","direction","atomic_amount"],
      "properties": {
        "entry_index":{"type":"integer","minimum":0,"maximum":31},
        "account_code":{"enum":["principal_available","principal_reserved","managed_escrow","provider_payable","provider_disputed","gateway_fee_revenue","gateway_refund_liability","payout_clearing","payout_disbursed","gateway_credit_issuance"]},
        "account_owner_id":{"type":"string","minLength":1,"maxLength":512},
        "direction":{"enum":["debit","credit"]},
        "atomic_amount":{"$ref":"#/$defs/atomicAmount"}
      }
    },
    "commitment": {
      "type":"object","additionalProperties":false,
      "required":["version","canonicalization","gateway_id","network_id","sequence","previous_commitment","event_id","event_type","idempotency_identity","occurred_unix_millis","ledger_reference","ledger_transaction_ids","asset","atomic_amount","identities","postings","reverses_event_id"],
      "properties": {
        "version":{"const":"atos_financial_commitment_v1"},
        "canonicalization":{"const":"rfc8949_core_deterministic_cbor"},
        "gateway_id":{"type":"string","minLength":1,"maxLength":253,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "network_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "sequence":{"type":"integer","minimum":1},
        "previous_commitment":{"$ref":"#/$defs/digest"},
        "event_id":{"type":"string","minLength":1,"maxLength":128},
        "event_type":{"enum":["account_genesis","reserve","reservation_release","escrow_fund","escrow_release","settlement_provider","settlement_fee","settlement_refund","partial_refund","full_refund","gateway_refund_fund","gateway_refund_pay","compensating_reversal","dispute_hold","dispute_release","payout_intent","payout_success","payout_failure","manual_adjustment"]},
        "idempotency_identity":{"type":"string","minLength":1,"maxLength":512},
        "occurred_unix_millis":{"type":"integer","minimum":1},
        "ledger_reference":{"type":"string","minLength":1,"maxLength":512},
        "ledger_transaction_ids":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}},
        "asset":{"type":"string","pattern":"^[A-Z][A-Z0-9]{1,15}$"},
        "atomic_amount":{"$ref":"#/$defs/atomicAmount"},
        "identities":{"$ref":"#/$defs/identities"},
        "postings":{"type":"array","minItems":2,"maxItems":32,"items":{"$ref":"#/$defs/posting"}},
        "reverses_event_id":{"type":"string","maxLength":128}
      }
    },
    "blnkChainTransaction": {
      "type":"object","additionalProperties":false,
      "required":["transaction_id","source","destination","reference","precise_amount","currency","description","status","created_at"],
      "properties": {
        "transaction_id":{"type":"string","minLength":1},"source":{"type":"string","minLength":1},
        "destination":{"type":"string","minLength":1},"reference":{"type":"string","minLength":1},
        "precise_amount":{"type":"integer","minimum":0},"currency":{"type":"string"},
        "description":{"type":"string"},"status":{"const":"APPLIED"},"created_at":{"type":"string","format":"date-time"}
      }
    },
    "blnkChainRow": {
      "type":"object","additionalProperties":false,
      "required":["transaction","ledger_amount","chain_version","chain_sequence","chain_previous_hash","chain_hash"],
      "properties": {
        "transaction":{"$ref":"#/$defs/blnkChainTransaction"},"ledger_amount":{"type":"string"},
        "chain_version":{"const":2},"chain_sequence":{"type":"integer","minimum":1},
        "chain_previous_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "chain_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    "blnkChainEvidence": {
      "type":"object","additionalProperties":false,"required":["state","transactions"],
      "properties": {
        "state":{"type":"object","additionalProperties":false,
          "required":["chain_key","first_sequence","last_sequence","previous_hash","head_hash","genesis_hash","unchained_transactions"],
          "properties":{"chain_key":{"const":"global"},"first_sequence":{"type":"integer","minimum":1},"last_sequence":{"type":"integer","minimum":1},"previous_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"head_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"genesis_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"unchained_transactions":{"const":0}}},
        "transactions":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"#/$defs/blnkChainRow"}}
      }
    },
    "batchManifestV2": {
      "type":"object","additionalProperties":false,
      "required":["version","canonicalization","gateway_id","network_id","batch_sequence","batch_id","first_sequence","last_sequence","commitment_count","previous_batch_id","previous_merkle_root","merkle_root","commitment_digests","ledger_evidence_digest","created_unix_millis"],
      "properties": {
        "version":{"const":"atos_financial_batch_v2"},"canonicalization":{"const":"rfc8949_core_deterministic_cbor"},
        "gateway_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},"network_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "batch_sequence":{"type":"integer","minimum":1},"batch_id":{"type":"string","pattern":"^fbat_[0-9a-f]{64}$"},
        "first_sequence":{"type":"integer","minimum":1},"last_sequence":{"type":"integer","minimum":1},"commitment_count":{"type":"integer","minimum":1,"maximum":4096},
        "previous_batch_id":{"type":"string"},"previous_merkle_root":{"$ref":"#/$defs/digest"},"merkle_root":{"$ref":"#/$defs/digest"},
        "commitment_digests":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"#/$defs/digest"}},
        "ledger_evidence_digest":{"$ref":"#/$defs/digest"},"created_unix_millis":{"type":"integer","minimum":1}
      }
    },
    "signatureEnvelopeV2": {
      "type":"object","additionalProperties":false,
      "required":["version","batch_id","manifest_digest","signing_digest","gateway_id","network_id","signing_key_id","signing_algorithm","signature","public_key","signed_unix_millis"],
      "properties": {
        "version":{"const":"atos_financial_batch_signature_v2"},
        "batch_id":{"type":"string","pattern":"^fbat_[0-9a-f]{64}$"},
        "manifest_digest":{"$ref":"#/$defs/digest"},"signing_digest":{"$ref":"#/$defs/digest"},
        "gateway_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "network_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "signing_key_id":{"type":"string","minLength":1},
        "signing_algorithm":{"enum":["ed25519","ecdsa_p256_sha256"]},
        "signature":{"type":"string","minLength":1},"public_key":{"type":"string","minLength":1},
        "signed_unix_millis":{"type":"integer","minimum":1}
      }
    },
    "evidenceBundleV2": {
      "type":"object","additionalProperties":false,
      "required":["version","manifest","manifest_cbor","commitments","ledger_evidence","signature"],
      "properties": {
        "version":{"const":"atos_financial_evidence_bundle_v2"},
        "manifest":{"$ref":"#/$defs/batchManifestV2"},
        "manifest_cbor":{"type":"string","contentEncoding":"base64"},
        "commitments":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"#/$defs/commitment"}},
        "ledger_evidence":{"$ref":"#/$defs/blnkChainEvidence"},
        "signature":{"$ref":"#/$defs/signatureEnvelopeV2"}
      }
    }
  }
}
