{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atos.im/schemas/protocol-types/0.2.0",
  "title": "ATOS Protocol Types v0.2",
  "description": "Normative reusable ATOS v0.2 trust-mode, proof, capability-mode, signer, and settlement types. Consumers should reference individual $defs.",
  "version": "0.2.0",
  "$defs": {
    "RequestedTrustMode": {
      "type": "string",
      "enum": ["managed", "verified", "native", "auto"],
      "description": "Pre-quote client trust selection policy. auto MUST resolve to a concrete trust mode before a Quote is issued."
    },
    "ConcreteTrustMode": {
      "type": "string",
      "enum": ["managed", "verified", "native"],
      "description": "Resolved trust mode used by Quotes, Invocations, Jobs, Escrows, Receipts, and settlements."
    },
    "ConcreteTrustModeSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ConcreteTrustMode"}
    },
    "ProviderRequestedTrustModes": {
      "allOf": [{"$ref": "#/$defs/ConcreteTrustModeSet"}],
      "description": "Concrete modes requested by a provider for activation/certification. Requesting a mode does not make it active."
    },
    "CapabilitySupportedTrustModes": {
      "allOf": [{"$ref": "#/$defs/ConcreteTrustModeSet"}],
      "description": "Concrete modes currently active and quotable for a capability. Derived from mode_support; auto is forbidden."
    },
    "StandardProofProfile": {
      "type": "string",
      "enum": ["tos_verified_v1", "tos_native_v1"],
      "description": "Initial standard proof profiles. Future versioned profile identifiers may be added without changing trust-mode semantics."
    },
    "ProofRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network_verifiable_receipt": {"type": "boolean", "default": false, "description": "true means required; false/omitted means not required, not forbidden"},
        "tos_settlement": {"type": "boolean", "default": false, "description": "true means TOS-backed settlement is required; false/omitted means not required, not forbidden"},
        "portable_proof_of_service": {"type": "boolean", "default": false, "description": "true means portable Proof-of-Service evidence is required; false/omitted means not required"}
      }
    },
    "ProofDescriptor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "quote_commitment": {"type": "boolean"},
        "execution_receipt": {"type": "boolean"},
        "settlement_proof": {"type": "boolean"},
        "proof_of_service": {"type": "boolean"},
        "proof_profile": {"type": ["string", "null"]}
      }
    },
    "FundingModel": {
      "type": "string",
      "enum": ["managed_balance", "client_tos", "client_supported_asset", "gateway_sponsored", "external_sponsor"]
    },
    "SettlementDescriptor": {
      "type": "object",
      "required": ["backend", "escrow"],
      "additionalProperties": true,
      "properties": {
        "backend": {"type": "string", "enum": ["atos_managed", "tos", "external_managed"]},
        "escrow": {"type": "boolean"},
        "funding_model": {"anyOf": [{"$ref": "#/$defs/FundingModel"}, {"type": "null"}]},
        "client_asset": {"type": ["string", "null"]},
        "provider_asset": {"type": ["string", "null"]}
      }
    },
    "ModeSupportState": {
      "type": "string",
      "enum": ["requested", "pending", "active", "suspended", "unsupported"]
    },
    "ModeSupportEntry": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": true,
      "properties": {
        "status": {"$ref": "#/$defs/ModeSupportState"},
        "proof_profile": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "CapabilityModeSupport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "managed": {"$ref": "#/$defs/ModeSupportEntry"},
        "verified": {"$ref": "#/$defs/ModeSupportEntry"},
        "native": {"$ref": "#/$defs/ModeSupportEntry"}
      }
    },
    "TrustSummary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "identity_assurance": {"type": "string"},
        "proof_of_service_count": {"type": "integer", "minimum": 0},
        "last_updated_at": {"type": "string"}
      },
      "description": "Gateway-normalized trust/reputation summary. This is not the transaction trust_mode."
    },
    "ExecutionSigner": {
      "type": "object",
      "required": ["execution_signer_id"],
      "additionalProperties": true,
      "properties": {
        "execution_signer_id": {"type": "string"},
        "signer_authorization_ref": {"type": ["string", "null"]},
        "signature": {"type": ["string", "null"]}
      },
      "description": "Signer/runtime attesting execution. For Verified/Native, its authorization for the quoted provider/capability/version must be verifiable."
    },
    "QuoteTrustContract": {
      "type": "object",
      "required": ["requested_trust_mode", "trust_mode", "settlement", "proof"],
      "additionalProperties": true,
      "properties": {
        "requested_trust_mode": {"$ref": "#/$defs/RequestedTrustMode"},
        "trust_mode": {"$ref": "#/$defs/ConcreteTrustMode"},
        "proof_profile": {"type": ["string", "null"]},
        "settlement": {"$ref": "#/$defs/SettlementDescriptor"},
        "proof": {"$ref": "#/$defs/ProofDescriptor"},
        "terms_hash": {"type": "string"},
        "dispute_policy_hash": {"type": ["string", "null"]}
      }
    },
    "ProofStatus": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "quote": {"type": "string", "enum": ["not_required", "pending", "committed", "failed"]},
        "escrow": {"type": "string", "enum": ["not_required", "pending", "reserved", "released", "settled", "failed"]},
        "receipt": {"type": "string", "enum": ["pending", "signed", "verified", "failed"]},
        "settlement": {"type": "string", "enum": ["not_required", "pending", "settled", "released", "disputed", "failed"]}
      }
    },
    "ReceiptTrustFields": {
      "type": "object",
      "required": ["trust_mode"],
      "additionalProperties": true,
      "properties": {
        "trust_mode": {"$ref": "#/$defs/ConcreteTrustMode"},
        "proof_profile": {"type": ["string", "null"]},
        "proof_status": {"type": ["string", "null"], "enum": ["not_required", "pending", "verified", "failed", null]},
        "network_proof_ref": {"type": ["string", "null"]},
        "input_commitment": {"type": ["string", "null"]},
        "output_commitment": {"type": ["string", "null"]},
        "usage_commitment": {"type": ["string", "null"]},
        "execution_signer_id": {"type": ["string", "null"]},
        "signer_authorization_ref": {"type": ["string", "null"]},
        "signature": {"type": ["string", "null"]}
      }
    }
  }
}
